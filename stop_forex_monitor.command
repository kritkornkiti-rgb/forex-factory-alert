#!/bin/bash
# ==============================================================================
# Stop Forex News Background Monitor
# ดับเบิ้ลคลิกเพื่อหยุดการทำงานของระบบเฝ้าระวัง
# ==============================================================================

DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
cd "$DIR"

PID=$(pgrep -f "forex_news.py --monitor")

if [ -n "$PID" ]; then
    kill $PID
    echo "🛑 หยุดการทำงานของระบบเฝ้าระวังเรียบร้อยแล้ว (PID: $PID)"
else
    echo "ℹ️ ไม่พบระบบเฝ้าระวังที่กำลังทำงานอยู่"
fi

echo ""
read -p "กด Enter เพื่อปิดหน้าต่างนี้..."
