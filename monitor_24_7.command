#!/bin/bash
# AI bottrade 24/7 Live Market Monitor Launcher for macOS
cd "$(dirname "$0")"
echo "=========================================================="
echo "   🛰️ กำลังเริ่มระบบติดตามกราฟและแจ้งเตือน 24/7..."
echo "=========================================================="
echo "ระบบกำลังเฝ้าดูกราฟทองคำ (GOLD) และบิตคอยน์ (BTC) ตลอดเวลา..."
echo "เมื่อมีสัญญาณ SMC เข้าเทรด จะส่งเสียงเตือนและแจ้งเตือนทันที!"
echo ""
echo "(กด Ctrl+C ในหน้าต่างนี้เมื่อต้องการหยุดเฝ้ากราฟ)"
echo "=========================================================="

.venv/bin/python main.py monitor --assets "GOLD (XAU/USD)" "BTC/USDT" --interval 60
