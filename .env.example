# ==============================================================================
# AI bottrade - Environment Configuration Template
# Copy this file to .env on your server and enter your credentials.
# ==============================================================================

# Telegram Alerts (Recommended for mobile notifications)
# 1. Message @BotFather on Telegram to get your BOT TOKEN
# 2. Message @userinfobot to get your numeric CHAT ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord Webhook (Optional)
# Right click Discord Channel -> Integrations -> Create Webhook
DISCORD_WEBHOOK_URL=

# LINE Notify (Optional)
LINE_TOKEN=
